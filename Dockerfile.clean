# 完全清理的 Dockerfile - 解决 npm 认证问题
FROM node:18-alpine

# 安装必要的系统依赖
RUN apk add --no-cache \
    libc6-compat \
    curl \
    openssl \
    python3 \
    make \
    g++ \
    && rm -rf /var/cache/apk/*

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS="--max-old-space-size=2048"

# 完全清理 npm 配置
RUN rm -rf /root/.npm \
    && rm -rf /tmp/.npm \
    && npm config delete registry \
    && npm config delete _auth \
    && npm config delete always-auth \
    && npm config delete email \
    && npm config delete username

# 设置干净的 npm 配置
ENV NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
ENV NPM_CONFIG_LOGLEVEL=warn
ENV NPM_CONFIG_PROGRESS=false
ENV NPM_CONFIG_AUDIT=false
ENV NPM_CONFIG_FUND=false
ENV NPM_CONFIG_ALWAYS_AUTH=false

# 复制包管理文件
COPY package.json package-lock.json* ./

# 重新配置 npm
RUN npm config set registry https://registry.npmjs.org/ \
    && npm config set always-auth false \
    && npm config set _auth "" \
    && npm config set fetch-retry-mintimeout 20000 \
    && npm config set fetch-retry-maxtimeout 120000 \
    && npm config set fetch-retries 5

# 清理所有缓存
RUN npm cache clean --force \
    && rm -rf /root/.npm/_cacache \
    && rm -rf /tmp/.npm

# 安装依赖
RUN npm install --no-audit --no-fund --no-optional

# 清理缓存
RUN npm cache clean --force \
    && rm -rf /tmp/* /root/.npm

# 复制源代码
COPY . .

# 生成 Prisma 客户端
RUN npx prisma generate

# 构建应用
RUN npm run build

# 创建非 root 用户
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

# 复制构建产物
COPY --chown=nextjs:nodejs /app/public ./public
COPY --chown=nextjs:nodejs /app/.next/standalone ./
COPY --chown=nextjs:nodejs /app/.next/static ./.next/static

# 复制 Prisma 相关文件
COPY --chown=nextjs:nodejs /app/prisma ./prisma
COPY --chown=nextjs:nodejs /app/node_modules/.prisma ./node_modules/.prisma
COPY --chown=nextjs:nodejs /app/node_modules/@prisma ./node_modules/@prisma

# 创建必要的目录
RUN mkdir -p /app/data /app/logs /app/sandbox-projects \
    && chown -R nextjs:nodejs /app/data /app/logs /app/sandbox-projects

# 切换到非 root 用户
USER nextjs

# 暴露端口
EXPOSE 3000

# 设置环境变量
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3000/api/health || exit 1

# 启动命令
CMD ["node", "server.js"]
