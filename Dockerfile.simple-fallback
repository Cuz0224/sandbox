# 简化版 Dockerfile - 适用于npm认证问题的fallback方案
FROM node:20-alpine

# 安装必要的系统依赖
RUN apk add --no-cache \
    libc6-compat \
    curl \
    openssl \
    python3 \
    make \
    g++

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# 完全重置npm环境并使用国内镜像
RUN rm -rf /root/.npm* /root/.npmrc /tmp/* \
    && npm config delete registry || true \
    && npm config delete _auth || true \
    && npm config delete _authToken || true \
    && npm config delete //registry.npmjs.org/:_authToken || true \
    && npm config set registry https://registry.npmmirror.com/ \
    && npm config set always-auth false \
    && npm cache clean --force

# 复制package文件
COPY package.json ./

# 安装依赖
RUN echo "=== 当前npm配置 ===" \
    && npm config list \
    && echo "=== 开始安装依赖 ===" \
    && npm install --no-audit --no-fund \
    && echo "=== 依赖安装完成 ==="

# 复制所有源代码（包括配置文件）
COPY . .

# 验证关键文件存在
RUN echo "=== 验证文件结构 ===" \
    && ls -la src/ \
    && ls -la src/components/ui/ \
    && ls -la tsconfig.json \
    && echo "=== 文件结构验证完成 ==="

# 生成 Prisma 客户端
RUN npx prisma generate

# 构建应用
RUN npm run build

# 暴露端口
EXPOSE 3000

# 启动命令
CMD ["npm", "start"]
