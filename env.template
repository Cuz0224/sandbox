# V0 Sandbox 环境变量配置模板
# 使用方法：复制此文件为 .env.local 并填入实际值

# ===== 基本配置 =====
NODE_ENV=production
NEXTAUTH_SECRET=your_secret_key_here_minimum_32_characters
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== 数据库配置 =====
# SQLite 本地数据库（默认）
DATABASE_URL="file:./data/prod.db"

# ===== AI 服务配置 =====
# Dify AI 服务（推荐）
DIFY_API_KEY=your_dify_api_key_here
DIFY_API_ENDPOINT=https://api.dify.ai/v1

# OpenAI 服务（可选）
OPENAI_API_KEY=your_openai_api_key_here

# Azure OpenAI 服务（可选）
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT_NAME=text-embedding-3-large
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4

# ===== Supabase 配置（用于向量数据库，可选）=====
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ===== 监控配置（可选）=====
GF_SECURITY_ADMIN_PASSWORD=admin123
REDIS_URL=redis://localhost:6379

# ===== 开发配置 =====
NEXT_TELEMETRY_DISABLED=1
DEBUG=false

# ===== 安全配置 =====
ALLOWED_ORIGINS=http://localhost:3000
JWT_SECRET=your_jwt_secret_here

# ===== 文件上传配置 =====
MAX_FILE_SIZE=10
ALLOWED_FILE_TYPES=js,ts,tsx,jsx,css,html,json,md
